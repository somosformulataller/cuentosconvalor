# Copia este archivo como .env y pega tus claves (el .env no viaja a ningún lado).
# En Vercel van las mismas en Settings → Environment Variables.

# La base y los audios: Supabase (proyecto guluzhoumokowgepgarm).
# DATABASE_URL: Connect → «Transaction pooler» (puerto 6543), con la contraseña de la base.
DATABASE_URL=
SUPABASE_URL=https://guluzhoumokowgepgarm.supabase.co
# Settings → API Keys → «Secret key» (sb_secret_...). Solo en el servidor.
SUPABASE_SECRET_KEY=

# Claude escribe las preguntas y los capítulos. Sin esta clave la app corre en
# "modo demostración" con un cuento de ejemplo, para ver cómo se ve.
ANTHROPIC_API_KEY=

# Opcional: el modelo de Claude (por defecto claude-opus-5-5).
# CLAUDE_MODEL=claude-opus-5-5

# La voz que narra el cuento. Con GEMINI_API_KEY narra Gemini TTS; si no hay, OpenAI
# TTS; sin ninguna, la voz del propio teléfono o computador (gratis, menos natural).
GEMINI_API_KEY=
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_TTS_VOICE=Sulafat

OPENAI_API_KEY=
# OPENAI_TTS_VOICE=coral
