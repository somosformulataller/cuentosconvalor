# Copia este archivo como .env y pega tus claves (el .env no viaja a ningún lado).
# En Vercel van las mismas en Settings → Environment Variables.

# La base y los audios: Supabase (proyecto guluzhoumokowgepgarm).
SUPABASE_URL=https://guluzhoumokowgepgarm.supabase.co
# Settings → API Keys → «Secret key» (sb_secret_...). Solo en el servidor.
SUPABASE_SECRET_KEY=

# Gemini escribe el cuento (gemini-3.8-flash) y lo narra (Gemini TTS). Sin esta
# clave la app corre en "modo demostración" con un cuento de ejemplo y la voz del
# propio teléfono. Usa una clave de pago: en el nivel gratis Google usa lo que se
# le envía para mejorar sus productos, y aquí van datos de niños.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_TTS_VOICE=Sulafat

# Opcional: si no hay GEMINI_API_KEY, la voz puede ser OpenAI TTS.
OPENAI_API_KEY=
# OPENAI_TTS_VOICE=coral
